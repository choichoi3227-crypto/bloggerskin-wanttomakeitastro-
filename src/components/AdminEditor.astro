<div class="editor-shell">
  <section class="admin-card">
    <div class="toolbar" aria-label="블록 에디터 도구">
      <button type="button" data-command="h1">H1</button><button type="button" data-command="h2">H2</button><button type="button" data-command="h3">H3</button>
      <button type="button" data-command="ul">리스트</button><button type="button" data-command="table">표</button><button type="button" data-command="button">버튼</button>
      <button type="button" data-command="mark">하이라이트</button><button type="button" data-command="link">링크</button><button type="button" data-command="image">이미지/미디어</button>
    </div>
    <label class="form-grid">HTML 에디터<textarea id="htmlEditor" rows="12" placeholder="HTML 콘텐츠를 입력하거나 블록 버튼으로 삽입하세요"></textarea></label>
    <h3>미리보기</h3><div id="editorPreview" class="editor-preview" contenteditable="true" aria-label="블록 에디터 미리보기"></div>
  </section>
  <aside>
    <details class="metabox" open><summary>게시 메타</summary><div class="form-grid">
      <label>제목<input id="editorTitle" placeholder="제목" /></label>
      <label>슬러그<input id="editorSlug" placeholder="seo-friendly-slug" /></label>
      <label>섹션<select id="editorType"><option value="post">게시글</option><option value="notice">공지</option><option value="community">커뮤니티</option><option value="forum">포럼</option><option value="support">지원금 섹션</option></select></label>
      <label>카테고리<input id="editorCategory" placeholder="직접 입력 또는 기존 카테고리" /></label>
      <label>공개 범위<select id="editorVisibility"><option value="public">비로그인 공개</option><option value="members">회원 전용</option></select></label>
    </div></details>
    <details class="metabox" open><summary>썸네일·미디어</summary><div class="form-grid">
      <label>썸네일 URL<input id="editorThumbnail" placeholder="/images/example.webp" /></label>
      <label>GitHub 업로드<input id="mediaUpload" type="file" accept="image/*,video/*" /></label>
      <button class="admin-action" id="uploadButton" type="button">images/ 폴더에 업로드</button>
    </div></details>
    <button class="solid-button" id="publishButton" type="button">GitHub와 D1에 게시</button>
  </aside>
</div>
<script>import '@/scripts/admin-editor.ts';</script>
