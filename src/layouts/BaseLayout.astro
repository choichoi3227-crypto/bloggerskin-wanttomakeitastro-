---
import '../styles/global.css';
import { buildTitle, jsonLdWebsite, type SeoProps } from '@/lib/seo';

interface Props extends SeoProps {
  noindex?: boolean;
}

const {
  title,
  description,
  path = '/',
  image = '/images/og-cloudpress.svg',
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false
} = Astro.props;
const siteUrl = Astro.locals.runtime?.env?.SITE_URL ?? 'https://cloudpress.kr';
const siteName = Astro.locals.runtime?.env?.SITE_NAME ?? '클라우드프레스';
const canonical = new URL(path, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const fullTitle = buildTitle(title, siteName);
const websiteSchema = jsonLdWebsite(siteUrl);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="클라우드프레스 정책 정보 플랫폼" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header">
      <nav class="nav-shell" aria-label="주요 메뉴">
        <a class="brand" href="/" aria-label="클라우드프레스 홈">
          <span class="brand-mark">☁</span>
          <span><strong>클라우드프레스</strong><small>정책을 압축해 읽다</small></span>
        </a>
        <div class="nav-links">
          <a href="/posts">게시글</a>
          <a href="/notices">공지</a>
          <a href="/community">커뮤니티</a>
          <a href="/forum">포럼</a>
        </div>
        <div class="auth-links">
          <a class="ghost-button" href="/auth/login">로그인</a>
          <a class="solid-button" href="/auth/signup">회원가입</a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>클라우드프레스</strong>
        <p>정부지원금 원천 데이터는 관리자 검수 전용으로 수집하며, 사용자에게는 게시글·공지·커뮤니티·포럼 콘텐츠만 제공합니다.</p>
      </div>
      <nav aria-label="정책 링크">
        <a href="/privacy">개인정보처리방침</a>
        <a href="/disclaimer">면책조항</a>
        <a href="/about-contact">소개 및 문의</a>
        <a href="/admin">관리자</a>
      </nav>
    </footer>
  </body>
</html>
